# Copy to backend/.env and fill in. Without a key the system runs on its rules engine.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# CIVIC_AI_MODE=rules   # force offline mode

# --- LLM cascade / caching (see README "Optimisations") ---
# CIVIC_CASCADE_THRESHOLD=0.85   # rules confidence at/above this skips the LLM (set >1 to always call the LLM)
# GROQ_FAST_MODEL=openai/gpt-oss-20b   # optional small-model tier tried before the big model
# CIVIC_LLM_CACHE_TTL=3600       # seconds; 0 disables the response cache

# --- MCP client ---
# CIVIC_MCP=off                  # disable all MCP tool calls
# CIVIC_MCP_CONFIG=mcp_servers.json   # defaults to the bundled rainfall server
